# ============================================================
# Full-stack — variáveis de ambiente (copie para .env)
# Cada serviço tem seu próprio .env.example com detalhes:
#   ia-service/.env.example
#   report-api/.env.example
# ============================================================

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (embeddings RAG)
OPENAI_API_KEY=sk-...

# PostgreSQL
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon123
POSTGRES_DB=hackathon_db

# RabbitMQ
RABBITMQ_USER=hackathon
RABBITMQ_PASSWORD=hackathon123

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
SQS_QUEUE_URL=

# App
LOG_LEVEL=INFO
REPORT_MODEL_BACKEND=langchain
LLM_MODEL=gpt-4o
